# URL pública de la API de Maxwear (backend-maxwear desplegado en Render)
NEXT_PUBLIC_API_URL=https://backend-maxwear.onrender.com/api/v1

# Metadatos del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth — sesión (JWT + refresh token propios de backend-maxwear)
# Genera un valor con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
